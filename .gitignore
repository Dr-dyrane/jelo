# generated asset operation output
data/asset-import-results.json
tmp/

# catalogue intake asset binaries — promoted to Vercel Blob on deploy.
# The PNGs are staged locally for the build to upload, then removed from
# git to avoid repo bloat. The promotion records in
# data/product-asset-promotions.json retain the canonical blob URLs.
data/catalogue-intake-assets/**/*.png
data/catalogue-intake-assets/**/*.jpg
data/catalogue-intake-assets/**/*.webp
data/catalogue-intake-assets/**/*.avif

# Playwright MCP browser side effects (snapshots, console logs)
.playwright-mcp/

# temporary preview images used during packshot sourcing
.tmp-preview/

# system files
.DS_Store

# Vercel project linkage and pulled environments
.vercel/

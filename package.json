    "catalogue:packshots:select": ".cache/rembg-venv/bin/python scripts/select-catalogue-packshots.py",
    "catalogue:packshots:validate": "tsx scripts/publish-catalogue-packshots.ts --validate-only",
    "catalogue:packshots:publish": "tsx scripts/publish-catalogue-packshots.ts",

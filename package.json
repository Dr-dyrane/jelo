    "docs:check": "tsx scripts/check-documentation.ts",
    "verify:release": "tsx scripts/verify-release.ts",
    "verify:research-integrity": "npm run catalogue:research:verify && npm run catalogue:research:packets:verify && npm run catalogue:research:offers:verify",
    "validate": "npm run verify:release && npm run build",
    "assets:audit": "tsx scripts/audit-catalogue-assets.ts",
    "assets:import": "node scripts/import-product-assets.mjs",
    "assets:static-import": "tsx scripts/import-static-product-assets.ts",
    "assets:promote:staged": "tsx scripts/promote-staged-product-assets.ts",

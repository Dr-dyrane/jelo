    "catalogue:pipeline:status": "tsx scripts/report-catalogue-pipeline.ts",
    "catalogue:intake:build": "tsx scripts/build-catalogue-intake-manifest.ts",
    "catalogue:intake:verify": "tsx scripts/verify-catalogue-intake-manifest.ts",
    "catalogue:intake:audit": "tsx scripts/audit-catalogue-intake.ts",

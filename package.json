    "assets:sync": "tsx scripts/sync-catalogue-assets.ts",
    "clinical:audit": "tsx scripts/audit-ingredient-knowledge.ts",
    "inventory:audit": "tsx scripts/audit-offer-inventory.ts",
    "inventory:prices": "tsx scripts/audit-offer-prices.ts",
    "inventory:queue": "tsx scripts/queue-inventory-refresh.ts",
    "inventory:work": "tsx scripts/process-inventory-refresh.ts",

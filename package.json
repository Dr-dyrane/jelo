{
  "name": "jelocare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/vercel-build.ts",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test modules/**/*.test.ts test/**/*.test.ts",
    "docs:check": "tsx scripts/check-documentation.ts",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run docs:check && npm run build",
    "assets:audit": "tsx scripts/audit-catalogue-assets.ts",
    "assets:import": "node scripts/import-product-assets.mjs",
    "assets:static-import": "tsx scripts/import-static-product-assets.ts",
    "assets:promote:staged": "tsx scripts/promote-staged-product-assets.ts",
    "assets:verify": "tsx scripts/verify-product-assets.ts",
    "ops:seed-operator": "tsx scripts/seed-moderation-operator.ts",
    "assets:product:seed": "tsx scripts/seed-product-asset-metadata.ts",
    "assets:editorial:seed": "tsx scripts/seed-editorial-assets.ts",
    "assets:sync": "tsx scripts/sync-catalogue-assets.ts",
    "clinical:audit": "tsx scripts/audit-ingredient-knowledge.ts",
    "inventory:audit": "tsx scripts/audit-offer-inventory.ts",
    "inventory:prices": "tsx scripts/audit-offer-prices.ts",
    "inventory:queue": "tsx scripts/queue-inventory-refresh.ts",
    "inventory:work": "tsx scripts/process-inventory-refresh.ts",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:seed": "tsx scripts/seed-catalogue.ts",
    "db:seed:external": "tsx scripts/seed-external-catalogue.ts",
    "catalogue:source": "tsx scripts/import-open-beauty-facts.ts",
    "catalogue:discovery:audit": "tsx scripts/audit-catalogue-discovery.ts",
    "catalogue:discovery:screen": "tsx scripts/screen-catalogue-discovery.ts",
    "catalogue:research:build": "tsx scripts/build-catalogue-research-queue.ts",
    "catalogue:research:verify": "tsx scripts/verify-catalogue-research-queue.ts",
    "catalogue:pipeline:status": "tsx scripts/report-catalogue-pipeline.ts",
    "catalogue:intake:audit": "tsx scripts/audit-catalogue-intake.ts",
    "catalogue:publication:verify": "tsx scripts/verify-catalogue-publication-dossiers.ts",
    "catalogue:publication:release": "tsx scripts/release-catalogue-candidate.ts",
    "catalogue:publication:releases:verify": "tsx scripts/verify-catalogue-publication-releases.ts",
    "catalogue:publication:images:verify": "tsx scripts/verify-catalogue-publication-images.ts",
    "catalogue:mirror": "tsx scripts/mirror-open-beauty-facts-images.ts",
    "catalogue:images:audit": "tsx scripts/audit-catalogue-image-quality.ts",
    "catalogue:packshots:prepare": "OMP_NUM_THREADS=1 U2NET_HOME=.cache/rembg-models .cache/rembg-venv/bin/python scripts/prepare-catalogue-packshots.py --output .cache/catalogue-packshots --model isnet-general-use --provider cpu --workers 8 --resume",
    "catalogue:packshot:prepare-reviewed": "U2NET_HOME=.cache/rembg-models .cache/reviewed-packshot-venv/bin/python scripts/prepare-reviewed-packshot.py --provider cpu",
    "catalogue:packshot:tool:check": ".cache/reviewed-packshot-venv/bin/python -m py_compile scripts/prepare-reviewed-packshot.py scripts/tests/test_prepare_reviewed_packshot.py && .cache/reviewed-packshot-venv/bin/python -m unittest discover -s scripts/tests -p 'test_*.py' -v",
    "catalogue:packshots:select": ".cache/rembg-venv/bin/python scripts/select-catalogue-packshots.py",
    "catalogue:packshots:validate": "tsx scripts/publish-catalogue-packshots.ts --validate-only",
    "catalogue:packshots:publish": "tsx scripts/publish-catalogue-packshots.ts",
    "catalogue:packshots:manifest:validate": "tsx scripts/validate-external-packshot-manifest.ts",
    "catalogue:packshots:remote:verify": "tsx scripts/validate-external-packshot-manifest.ts --remote",
    "community:intake:purge": "tsx scripts/purge-community-intake-drafts.ts",
    "community:research:signals": "tsx scripts/report-community-research-signals.ts"

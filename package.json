    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,css,json,md}": "prettier --write"
  },
  "overrides": {
    "postcss": "8.5.21",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "@playwright/browser-chromium@1.62.1": true
  }

  "dependencies": {
    "@ai-sdk/react": "3.0.221",
    "@neondatabase/auth": "0.4.2-beta",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "2.6.1",
    "ai": "6.0.224",
    "lucide-react": "1.25.0",
    "next": "16.2.11",
    "nodemailer": "9.0.3",
    "postgres": "3.4.7",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.11",
    "sharp": "0.35.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.21",
    "sharp": "0.35.3"
  }

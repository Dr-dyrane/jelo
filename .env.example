# JeloCare environment template
# Copy to .env.local for local development. Never commit real secrets.

# Application
AI_GATEWAY_API_KEY=
JELLOCARE_AI_MODEL=anthropic/claude-sonnet-4.5
NEXT_PUBLIC_SITE_URL=https://jelocare.com
# Keep "static" until migrations and seeding are complete, then switch to "neon".
CATALOGUE_SOURCE=static

# Vercel Blob
# Public catalogue/editorial asset store metadata and server-only write access.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
BLOB_READ_WRITE_TOKEN=

# Neon PostgreSQL — preferred application connection strings
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon PostgreSQL — Vercel/Neon generated compatibility variables
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
PGHOST=
PGHOST_UNPOOLED=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGPORT=
NEON_PROJECT_ID=

# Neon Auth integration metadata
# Keep server-only unless a documented client-auth flow is intentionally added.
NEON_AUTH_BASE_URL=
# Auto-generated for Vite compatibility. JeloCare is Next.js; do not use this in
# browser code or treat it as a NEXT_PUBLIC variable without an explicit review.
VITE_NEON_AUTH_URL=

# Vercel Edge Config
# Read-only runtime feature flags and campaign configuration.
EDGE_CONFIG=

# Upstash Redis / Vercel KV compatibility
# Cache, rate limiting and short-lived state only; never the source of truth.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
REDIS_URL=

# JeloCare environment template
# Copy to .env.local for local development. Never commit real secrets.

# Application
NEXT_PUBLIC_SITE_URL=https://www.jelocare.com
# Keep "static" until migrations and seeding are complete, then switch to "neon".
CATALOGUE_SOURCE=static

# Transactional email
# Preferred: a mailbox-scoped Agentic Mail API token from
# hPanel → Emails → your domain → Agentic mail → API.
EMAIL_PROVIDER=hostinger-api
EMAIL_API_TOKEN=
# Optional fallback: use hostinger-smtp with the mailbox password.
EMAIL_SMTP_PASSWORD=
EMAIL_FROM="JeloCare <hello@jelocare.com>"
EMAIL_FROM_ADDRESS=hello@jelocare.com
EMAIL_REPLY_TO=hello@jelocare.com

# Public request throttling
CONSULT_RATE_LIMIT_SECRET=
COMMUNITY_INTAKE_RATE_LIMIT_SECRET=
RETAILER_PARTNERSHIP_RATE_LIMIT_SECRET=

# Scheduled and release operations
CRON_SECRET=
# Emergency/CI control. Keep disabled in normal production releases.
SKIP_DATABASE_MIGRATIONS=0
# One-time external discovery import only. Reviewed catalogue sync is automatic.
SEED_EXTERNAL_CATALOGUE_ON_BUILD=0

# Vercel Blob
# Public catalogue/editorial asset store metadata and server-only write access.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
BLOB_READ_WRITE_TOKEN=

# Neon PostgreSQL — preferred application connection strings
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon PostgreSQL — Vercel/Neon generated compatibility variables
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
PGHOST=
PGHOST_UNPOOLED=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGPORT=
NEON_PROJECT_ID=

# Neon Auth integration metadata (Managed Better Auth, @neondatabase/auth).
# Keep server-only unless a documented client-auth flow is intentionally added.
NEON_AUTH_BASE_URL=
# Signs/encrypts the Neon Auth session-cache cookie. SECRET, server-only, REQUIRED
# for the moderation console. Must be >= 32 chars. Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Local/private CLI only. Must match one active moderation_operators email; the
# application runtime does not read it and it should not be added to Vercel.
MODERATION_OPERATOR_EMAIL=
# Auto-generated for Vite compatibility. JeloCare is Next.js; do not use this in
# browser code or treat it as a NEXT_PUBLIC variable without an explicit review.
VITE_NEON_AUTH_URL=

# Vercel Edge Config
# Read-only runtime feature flags and campaign configuration.
EDGE_CONFIG=

# Upstash Redis / Vercel KV compatibility
# Cache, rate limiting and short-lived state only; never the source of truth.
# Every production-mode Ask Jelo runtime requires both REST values and fails
# closed without them. This includes Vercel Production, Vercel Preview, and
# local `next start`; only `next dev` and tests may omit them.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
REDIS_URL=

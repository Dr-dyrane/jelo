# JeloCare environment template
# Copy to .env.local for local development. Never commit real secrets.

# Application
NEXT_PUBLIC_SITE_URL=https://www.jelocare.com
# Keep "static" until migrations and seeding are complete, then switch to "neon".
CATALOGUE_SOURCE=static

# Transactional email
# Preferred: a mailbox-scoped Agentic Mail API token from
# hPanel → Emails → your domain → Agentic mail → API.
EMAIL_PROVIDER=hostinger-api
EMAIL_API_TOKEN=
# Recommended resilience fallback. When API mailbox discovery or an explicit
# client rejection proves that no message was accepted, SMTP uses this mailbox
# password automatically. Ambiguous API send outcomes remain fail-closed.
EMAIL_SMTP_PASSWORD=
EMAIL_FROM="JeloCare <hello@jelocare.com>"
EMAIL_FROM_ADDRESS=hello@jelocare.com
EMAIL_REPLY_TO=hello@jelocare.com

# Public request throttling
CONSULT_RATE_LIMIT_SECRET=
COMMUNITY_INTAKE_RATE_LIMIT_SECRET=
RETAILER_PARTNERSHIP_RATE_LIMIT_SECRET=
ASSISTED_ORDER_RATE_LIMIT_SECRET=
LOCATION_RATE_LIMIT_SECRET=

# Server-only Nigeria address suggestions. Geoapify's free plan requires
# attribution and currently includes 3,000 credits/day. Never expose this as
# NEXT_PUBLIC; checkout keeps a complete manual-entry fallback.
GEOAPIFY_API_KEY=

# Governed assisted-order payment. Both values are configured server-side for
# the hosted Paystack redirect flow. PAYSTACK_SECRET_KEY also verifies webhook
# HMAC-SHA512 signatures; there is no separate webhook-signing secret.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Ask Jelo AI intake shadow mode. The deterministic safety and care engine remains
# the only customer-visible authority. Vercel uses project OIDC automatically;
# AI_GATEWAY_API_KEY is an optional server-only local fallback.
ASK_JELO_AI_INTAKE_SHADOW=false
ASK_JELO_INTAKE_MODEL=google/gemini-2.5-flash-lite
ASK_JELO_INTAKE_FALLBACK_MODEL=openai/gpt-5.4-nano
AI_GATEWAY_API_KEY=

# Scheduled and release operations
CRON_SECRET=

# Daily campaign handoff. Keep disabled until the preview and test-delivery
# approval gates pass. Recipient values are server-only and never enter campaign
# archives; production also requires one exact active moderation operator row.
CAMPAIGN_DAILY_ENABLED=false
CAMPAIGN_TEST_EMAIL=
CAMPAIGN_DAILY_OPERATOR_EMAIL=

# Inventory extraction and review-branch static sync. AI observations remain
# database-only. Static sync accepts only the inventory-sync-review branch
# namespace so price and stock changes pass human review before publication.
INVENTORY_AI_EXTRACTION=false
INVENTORY_AI_EXTRACTION_MODEL=
STATIC_FILE_SYNC_ENABLED=false
GITHUB_TOKEN=
GITHUB_REPO_OWNER=Dr-dyrane
GITHUB_REPO_NAME=jelo
GITHUB_REPO_BRANCH=inventory-sync-review

# Vercel Blob
# Public catalogue/editorial asset store metadata and server-only write access.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
BLOB_READ_WRITE_TOKEN=

# Neon PostgreSQL — production runtime roles are exact and server-only.
# Pooled URL whose login role is jelocare_app_runtime.
DATABASE_URL=
# Dedicated pooled URL whose login role is jelocare_shelf_runtime. No fallback.
CUSTOMER_SHELF_DATABASE_URL=
# Name documented only: inject the direct, non-pooled admin URL into a protected
# operator/release process. Leave it empty in app env files and never add it to Vercel.
MIGRATION_DATABASE_URL=

# Neon PostgreSQL — optional generated runtime compatibility variables.
# In Vercel, delete unused aliases; any retained URL/user fields must resolve
# only to jelocare_app_runtime, never an owner or migration administrator.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
PGHOST=
PGHOST_UNPOOLED=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGPORT=
NEON_PROJECT_ID=

# Neon Auth integration metadata (Managed Better Auth, @neondatabase/auth).
# Keep server-only unless a documented client-auth flow is intentionally added.
NEON_AUTH_BASE_URL=
# Signs/encrypts the Neon Auth session-cache cookie. SECRET, server-only, REQUIRED
# for the moderation console. Must be >= 32 chars. Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Local/private CLI only. Must match one active moderation_operators email; the
# application runtime does not read it and it should not be added to Vercel.
MODERATION_OPERATOR_EMAIL=
# Auto-generated for Vite compatibility. JeloCare is Next.js; do not use this in
# browser code or treat it as a NEXT_PUBLIC variable without an explicit review.
VITE_NEON_AUTH_URL=

# Vercel Edge Config
# Read-only runtime feature flags and campaign configuration.
EDGE_CONFIG=

# Upstash Redis / Vercel KV
# Rate limiting plus the private append-only daily campaign delivery ledger.
# Every production-mode Ask Jelo runtime requires both REST values and fails
# closed without them. This includes Vercel Production, Vercel Preview, and
# local `next start`; only `next dev` and tests may omit them.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
REDIS_URL=
